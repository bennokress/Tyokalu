    "Työkalu needs permission to send notifications. Please review your settings.": {
      "comment": "Error message for missing notification permission",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Työkalu potřebuje oprávnění k odesílání oznámení. Zkontrolujte prosím svá nastavení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Työkalu benötigt die Berechtigung zum Senden von Mitteilungen. Bitte überprüfe deine Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Työkalu needs permission to send notifications. Please review your settings."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Työkalu needs permission to send notifications. Please review your settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Työkalu necesita permiso para enviar notificaciones. Por favor, revisa tus ajustes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Työkalu vajab luba teavituste saatmiseks. Palun vaata üle oma seaded."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Työkalu tarvitsee luvan lähettää ilmoituksia. Tarkista asetuksesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Työkalu a besoin de l'autorisation d'envoyer des notifications. Veuillez vérifier vos réglages."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Työkalu alkalmazásnak engedélyre van szüksége az értesítések küldéséhez. Kérjük, ellenőrizd a beállításaidat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Työkalu ha bisogno dell'autorizzazione per inviare notifiche. Controlla le tue impostazioni."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Työkalu reikia leidimo siųsti pranešimus. Prašome peržiūrėti savo nustatymus."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Työkalu ir nepieciešama atļauja sūtīt paziņojumus. Lūdzu, pārskatiet savus iestatījumus."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Työkalu trenger tillatelse til å sende varsler. Vennligst sjekk innstillingene dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Työkalu heeft toestemming nodig om meldingen te versturen. Controleer je instellingen."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Työkalu treng løyve til å sende varslar. Ver venleg og sjekk innstillingane dine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Työkalu potrzebuje uprawnienia do wysyłania powiadomień. Proszę sprawdzić swoje ustawienia."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Työkalu potrebuje povolenie na odosielanie oznámení. Prosím skontrolujte vaše nastavenia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Työkalu potrebuje dovoljenje za pošiljanje obvestil. Prosimo, preglejte svoje nastavitve."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Työkalu behöver behörighet att skicka aviseringar. Vänligen kontrollera dina inställningar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Työkalu потребує дозволу на надсилання сповіщень. Будь ласка, перевірте ваші налаштування."
          }
        }
      }
    },
