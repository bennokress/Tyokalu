{
  "sourceLanguage": "en",
  "strings": {
    "\"Työkalu\" is the Finnish word for \"tool\".": {
      "comment": "Different sentence only in Finnish!",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Työkalu\" je finské slovo pro \"nástroj\"."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Työkalu\" ist das finnische Wort für \"Werkzeug\"."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Työkalu\" is the Finnish word for \"tool\"."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Työkalu\" is the Finnish word for \"tool\"."
          }
        },
        "es": {
