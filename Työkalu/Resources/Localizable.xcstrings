    "Turning this on will allow the notification to break through Focus Modes": {
      "comment": "Parameter description",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Включването на това ще позволи на известието да прекъсва режимите Фокус"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapnutím této možnosti umožníte oznámení prolomit režimy soustředění"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, kann die Mitteilung Fokusmodi durchbrechen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ενεργοποίηση αυτού θα επιτρέψει στην ειδοποίηση να παρακάμψει τις λειτουργίες συγκέντρωσης"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turning this on will allow the notification to break through Focus Modes"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Turning this on will allow the notification to break through Focus Modes"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activar esto permitirá que la notificación atraviese los modos de concentración"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selle sisselülitamine võimaldab teavitusel läbida fookusrežiime"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän käyttöönotto sallii ilmoituksen ohittaa keskittymistilat"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer cette option permettra à la notification de passer outre les modes de concentration"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uključivanje ove opcije omogućit će obavijesti da probije modove fokusa"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennek bekapcsolása lehetővé teszi az értesítésnek, hogy áttörjön a Fókusz módokon"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivando questa opzione la notifica potrà ignorare le modalità Full Immersion"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これをオンにすると、通知が集中モードを突破できるようになります"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įjungus tai, pranešimas galės prasiveržti pro susitelkimo režimus"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ieslēdzot šo, paziņojums varēs pārraut fokusa režīmus"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å slå dette på vil tillate varselet å bryte gjennom fokusmoduser"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als dit is ingeschakeld, kan de melding door focusmodi heen breken"
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Å slå dette på vil tillate varselet å bryte gjennom fokusmodusane"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włączenie tej opcji pozwoli powiadomieniu przebić się przez tryby skupienia"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activarea acestei opțiuni va permite notificării să treacă prin modurile Focus"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapnutím tejto možnosti povolíte oznámeniu prerušiť režimy sústredenia"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vklop te možnosti bo obvestilu omogočil preboj skozi načine fokusa"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att slå på detta tillåter aviseringen att bryta igenom fokuslägen"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu etkinleştirmek, bildirimin Odak Modlarını aşmasına izin verecektir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкнення цього дозволить сповіщенню проривати режими фокусування"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启此选项将允许通知突破专注模式"
          }
        }
      }
    },
