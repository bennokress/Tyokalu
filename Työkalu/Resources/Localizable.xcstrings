    "This action will return a Boolean value representing if the given date has the given type of day.": {
      "comment": "Intent description",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това действие ще върне булева стойност, представляваща дали дадената дата има дадения тип ден."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato akce vrátí booleovskou hodnotu reprezentující, zda má dané datum daný typ dne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aktion gibt einen booleschen Wert zurück, der angibt, ob das gegebene Datum den gegebenen Tagestyp hat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η ενέργεια θα επιστρέψει μια τιμή Boolean που υποδεικνύει αν η δεδομένη ημερομηνία έχει τον δεδομένο τύπο ημέρας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action will return a Boolean value representing if the given date has the given type of day."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This action will return a Boolean value representing if the given date has the given type of day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta acción devolverá un valor booleano que representa si la fecha dada tiene el tipo de día dado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See toiming tagastab tõeväärtuse, mis näitab, kas antud kuupäev on antud päevatüüp."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä toiminto palauttaa totuusarvon, joka kertoo onko annetulla päivämäärällä annettu päivätyyppi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action renverra une valeur booléenne indiquant si la date donnée correspond au type de jour donné."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova radnja će vratiti Booleovu vrijednost koja predstavlja ima li dani datum danu vrstu dana."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a művelet egy logikai értéket ad vissza, amely jelzi, hogy az adott dátum az adott naptípussal rendelkezik-e."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa azione restituirà un valore booleano che indica se la data fornita ha il tipo di giorno specificato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアクションは、指定された日付が指定された曜日の種類かどうかを表すブール値を返します。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis veiksmas grąžins loginę reikšmę, nurodančią, ar nurodyta data turi nurodytą dienos tipą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šī darbība atgriezīs Būla vērtību, kas norāda, vai dotajam datumam ir dotais dienas tips."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne handlingen vil returnere en boolsk verdi som representerer om den gitte datoen har den gitte typen dag."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze handeling retourneert een Booleaanse waarde die aangeeft of de gegeven datum het gegeven type dag heeft."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne handlinga vil returnere ein boolsk verdi som representerer om den gjevne datoen har den gjevne typen dag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta czynność zwróci wartość logiczną reprezentującą, czy podana data ma podany typ dnia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această acțiune va returna o valoare booleană care reprezintă dacă data dată are tipul de zi dat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Táto akcia vráti boolovskú hodnotu reprezentujúcu, či daný dátum má daný typ dňa."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "To dejanje bo vrnilo logično vrednost, ki predstavlja, ali ima dani datum dano vrsto dneva."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Denna åtgärd returnerar ett booleskt värde som representerar om det angivna datumet har den angivna typen av dag."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem, verilen tarihin verilen gün türüne sahip olup olmadığını temsil eden bir Boolean değeri döndürür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця дія поверне логічне значення, яке вказує, чи задана дата має заданий тип дня."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作将返回一个布尔值，表示给定日期是否具有给定的日期类型。"
          }
        }
      }
    },
