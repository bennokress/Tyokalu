  "strings": {
    "\"Työkalu\" is the Finnish word for \"tool\".": {
      "comment": "Different sentence only in Finnish!",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Työkalu\" ist das finnische Wort für \"Werkzeug\"."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Työkalu\" is the Finnish word for \"tool\"."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Työkalu\" is the Finnish word for \"tool\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Työkalu\" es la palabra finlandesa para \"herramienta\"."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muissa lokalisoinneissa selitetään tämän sovelluksen nimen merkitys. Tätä selitystä et tietenkään tarvitse!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Työkalu\" est le mot finnois pour \"outil\"."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Työkalu\" è la parola finlandese per \"strumento\"."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Työkalu\" er det finske ordet for \"verktøy\"."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Työkalu\" is het Finse woord voor \"gereedschap\"."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Työkalu\" er det finske ordet for \"verktøy\"."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Työkalu\" to fińskie słowo oznaczające \"narzędzie\"."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Työkalu\" är det finska ordet för \"verktyg\"."
          }
        }
      }
    },
    "A Date can never be between two equal hours, please enter different numbers as earlier and later hours": {
      "comment": "Error message",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Datum kann nie zwischen zwei gleichen Stunden liegen. Bitte gib unterschiedliche Zahlen für die frühere und spätere Stunde ein"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Date can never be between two equal hours, please enter different numbers as earlier and later hours"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A Date can never be between two equal hours, please enter different numbers as earlier and later hours"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una fecha nunca puede estar entre dos horas iguales, por favor introduce números diferentes para la hora anterior y posterior"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivämäärä ei voi koskaan olla kahden saman tunnin välissä, anna eri numerot aikaisemmaksi ja myöhemmäksi tunniksi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une date ne peut jamais se situer entre deux heures identiques. Veuillez entrer des nombres différents pour les heures de début et de fin"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una data non può mai essere compresa tra due ore uguali, inserisci numeri diversi per l'ora precedente e quella successiva"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En dato kan aldri være mellom to like timer, vennligst oppgi forskjellige tall for tidligere og senere time"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een datum kan nooit tussen twee gelijke uren vallen. Voer verschillende getallen in voor het eerdere en latere uur"
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein dato kan aldri vere mellom to like timar, ver venleg og oppgje ulike tal for tidlegare og seinare time"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Data nigdy nie może być między dwiema równymi godzinami, proszę podać różne liczby dla wcześniejszej i późniejszej godziny"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett datum kan aldrig vara mellan två lika timmar, vänligen ange olika tal för tidigare och senare timme"
          }
        }
      }
    },
    "A day has 24 hours, so checking against hours higher than 24 is impossible": {
      "comment": "Error message",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tag hat 24 Stunden, daher ist eine Prüfung gegen Stunden über 24 nicht möglich"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A day has 24 hours, so checking against hours higher than 24 is impossible"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A day has 24 hours, so checking against hours higher than 24 is impossible"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un día tiene 24 horas, por lo que es imposible comprobar horas superiores a 24"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivässä on 24 tuntia, joten yli 24 tunnin tarkistaminen on mahdotonta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une journée a 24 heures, il est donc impossible de vérifier des heures supérieures à 24"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un giorno ha 24 ore, quindi non è possibile verificare ore superiori a 24"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En dag har 24 timer, så det er umulig å sjekke mot timer høyere enn 24"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een dag heeft 24 uur, dus controleren op uren hoger dan 24 is onmogelijk"
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein dag har 24 timar, så det er umogleg å sjekke mot timar høgare enn 24"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzień ma 24 godziny, więc sprawdzanie godzin wyższych niż 24 jest niemożliwe"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En dag har 24 timmar, så det är omöjligt att kontrollera mot timmar högre än 24"
          }
        }
      }
    },
    "A day has no negative hours, so checking against hours lower than 0 is impossible": {
      "comment": "Error message",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tag hat keine negativen Stunden, daher ist eine Prüfung gegen Stunden unter 0 nicht möglich"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A day has no negative hours, so checking against hours lower than 0 is impossible"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A day has no negative hours, so checking against hours lower than 0 is impossible"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un día no tiene horas negativas, por lo que es imposible comprobar horas inferiores a 0"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivässä ei ole negatiivisia tunteja, joten alle 0 tunnin tarkistaminen on mahdotonta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une journée n'a pas d'heures négatives, il est donc impossible de vérifier des heures inférieures à 0"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un giorno non ha ore negative, quindi non è possibile verificare ore inferiori a 0"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En dag har ingen negative timer, så det er umulig å sjekke mot timer lavere enn 0"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een dag heeft geen negatieve uren, dus controleren op uren lager dan 0 is onmogelijk"
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein dag har ingen negative timar, så det er umogleg å sjekke mot timar lågare enn 0"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzień nie ma ujemnych godzin, więc sprawdzanie godzin niższych niż 0 jest niemożliwe"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En dag har inga negativa timmar, så det är omöjligt att kontrollera mot timmar lägre än 0"
          }
        }
      }
    },
