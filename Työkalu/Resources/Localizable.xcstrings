    "Opens a system dialog to allow notifications from this app": {
      "comment": "Accessibility hint for permission button",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отваря системен диалог за разрешаване на известия от това приложение"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevře systémový dialog pro povolení oznámení z této aplikace"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet einen Systemdialog, um Mitteilungen von dieser App zu erlauben"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίγει ένα παράθυρο διαλόγου συστήματος για να επιτρέψει ειδοποιήσεις από αυτήν την εφαρμογή"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens a system dialog to allow notifications from this app"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
