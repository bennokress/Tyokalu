            "value": "\"Työkalu\" to fińskie słowo oznaczające \"narzędzie\"."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Työkalu\" je fínske slovo pre \"nástroj\"."
