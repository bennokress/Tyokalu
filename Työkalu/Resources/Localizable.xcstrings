    "Notifications on iOS do not support attachments as large as the one you provided.": {
      "comment": "Error message for attachment too large",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznámení na iOS nepodporují tak velké přílohy jako ta, kterou jste poskytli."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen auf iOS unterstützen keine so großen Anhänge wie den von dir bereitgestellten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications on iOS do not support attachments as large as the one you provided."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications on iOS do not support attachments as large as the one you provided."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones en iOS no admiten adjuntos tan grandes como el que proporcionaste."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS-i teavitused ei toeta nii suuri manuseid, nagu sina esitasid."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS:n ilmoitukset eivät tue niin suuria liitteitä kuin antamasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sur iOS ne prennent pas en charge les pièces jointes aussi volumineuses que celle fournie."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az iOS értesítései nem támogatnak olyan nagy mellékleteket, mint amilyet megadtál."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche su iOS non supportano allegati grandi come quello che hai fornito."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS pranešimai nepalaiko tokio dydžio priedų, kokį pateikėte."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Paziņojumi iOS neatbalsta tik lielus pielikumus kā jūsu nodrošinātais."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsler på iOS støtter ikke vedlegg så store som det du oppga."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen op iOS ondersteunen geen bijlagen zo groot als de door jou opgegeven bijlage."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Varslar på iOS støttar ikkje vedlegg så store som det du oppgav."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia na iOS nie obsługują załączników tak dużych jak ten, który podałeś."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznámenia na iOS nepodporujú tak veľké prílohy, aká bola poskytnutá."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obvestila na iOS ne podpirajo tako velikih priponk, kot je tista, ki ste jo posredovali."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviseringar på iOS stöder inte bilagor så stora som den du angav."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщення на iOS не підтримують вкладення такого розміру, як надане вами."
          }
        }
      }
    },
