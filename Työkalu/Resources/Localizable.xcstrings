        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Paziņojumi iOS neatbalsta tik lielus pielikumus kā jūsu nodrošinātais."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsler på iOS støtter ikke vedlegg så store som det du oppga."
          }
