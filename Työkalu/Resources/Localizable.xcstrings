    "What happens when you tap on the notification": {
      "comment": "Parameter description",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Какво се случва, когато докоснете известието"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Co se stane, když klepnete na oznámení"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was passiert, wenn du auf die Mitteilung tippst"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τι συμβαίνει όταν πατάτε την ειδοποίηση"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What happens when you tap on the notification"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "What happens when you tap on the notification"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué ocurre cuando tocas la notificación"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mis juhtub, kui vajutad teavitusele"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitä tapahtuu kun napautat ilmoitusta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui se passe lorsque vous touchez la notification"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Što se događa kada dodirnete obavijest"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi történik, amikor az értesítésre koppintasz"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa succede quando tocchi la notifica"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知をタップしたときに起こること"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kas nutinka, kai paliečiate pranešimą"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kas notiek, kad pieskaraties paziņojumam"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hva som skjer når du trykker på varselet"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat er gebeurt als je op de melding tikt"
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kva som skjer når du trykker på varselet"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co się dzieje po dotknięciu powiadomienia"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce se întâmplă când atingeți notificarea"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čo sa stane, keď ťuknete na oznámenie"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaj se zgodi, ko tapnete na obvestilo"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad som händer när du trycker på aviseringen"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirime dokunduğunuzda ne olur"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що відбувається, коли ви натискаєте на сповіщення"
          }
        },
        "zh-Hans": {
          "stringUnit": {
