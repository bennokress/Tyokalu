        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivässä ei ole negatiivisia tunteja, joten alle 0 tunnin tarkistaminen on mahdotonta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une journée n'a pas d'heures négatives, il est donc impossible de vérifier des heures inférieures à 0"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy napnak nincsenek negatív órái, ezért 0-nál alacsonyabb óra ellenőrzése lehetetlen"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un giorno non ha ore negative, quindi non è possibile verificare ore inferiori a 0"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Paroje nėra neigiamų valandų, todėl tikrinti valandas, mažesnes nei 0, neįmanoma"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dienā nav negatīvu stundu, tāpēc pārbaude pret stundām, kas mazākas par 0, nav iespējama"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En dag har ingen negative timer, så det er umulig å sjekke mot timer lavere enn 0"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een dag heeft geen negatieve uren, dus controleren op uren lager dan 0 is onmogelijk"
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein dag har ingen negative timar, så det er umogleg å sjekke mot timar lågare enn 0"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzień nie ma ujemnych godzin, więc sprawdzanie godzin niższych niż 0 jest niemożliwe"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Deň nemá záporné hodiny, preto nie je možné kontrolovať hodiny nižšie ako 0"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dan nima negativnih ur, zato preverjanje ur nižjih od 0 ni mogoče"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En dag har inga negativa timmar, så det är omöjligt att kontrollera mot timmar lägre än 0"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "День не має від'ємних годин, тому перевірка годин менше 0 неможлива"
          }
        }
      }
    },
