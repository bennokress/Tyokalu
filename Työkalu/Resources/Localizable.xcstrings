    "A Date can never be between two equal hours, please enter different numbers as earlier and later hours": {
      "comment": "Error message",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Datum nemůže být mezi dvěma stejnými hodinami, zadejte prosím různá čísla pro dřívější a pozdější hodinu"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Datum kann nie zwischen zwei gleichen Stunden liegen. Bitte gib unterschiedliche Zahlen für die frühere und spätere Stunde ein"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Date can never be between two equal hours, please enter different numbers as earlier and later hours"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A Date can never be between two equal hours, please enter different numbers as earlier and later hours"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una fecha nunca puede estar entre dos horas iguales, por favor introduce números diferentes para la hora anterior y posterior"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuupäev ei saa kunagi olla kahe võrdse tunni vahel, palun sisesta varasema ja hilisema tunni jaoks erinevad numbrid"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivämäärä ei voi koskaan olla kahden saman tunnin välissä, anna eri numerot aikaisemmaksi ja myöhemmäksi tunniksi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une date ne peut jamais se situer entre deux heures identiques. Veuillez entrer des nombres différents pour les heures de début et de fin"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy dátum soha nem lehet két egyenlő óra között, kérjük, adj meg különböző számokat korábbi és későbbi óraként"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una data non può mai essere compresa tra due ore uguali, inserisci numeri diversi per l'ora precedente e quella successiva"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Data niekada negali būti tarp dviejų vienodų valandų, prašome įvesti skirtingus skaičius kaip ankstesnę ir vėlesnę valandas"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Datums nekad nevar būt starp divām vienādām stundām, lūdzu, ievadiet dažādus skaitļus agrākai un vēlākai stundai"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En dato kan aldri være mellom to like timer, vennligst oppgi forskjellige tall for tidligere og senere time"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een datum kan nooit tussen twee gelijke uren vallen. Voer verschillende getallen in voor het eerdere en latere uur"
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein dato kan aldri vere mellom to like timar, ver venleg og oppgje ulike tal for tidlegare og seinare time"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Data nigdy nie może być między dwiema równymi godzinami, proszę podać różne liczby dla wcześniejszej i późniejszej godziny"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dátum nemôže byť nikdy medzi dvoma rovnakými hodinami, prosím zadajte rôzne čísla pre skoršiu a neskoršiu hodinu"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Datum ne more biti med dvema enakima urama, prosimo vnesite različni številki za zgodnejšo in kasnejšo uro"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett datum kan aldrig vara mellan två lika timmar, vänligen ange olika tal för tidigare och senare timme"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дата не може бути між двома однаковими годинами, будь ласка, введіть різні числа для початкової та кінцевої години"
          }
        }
      }
    },
    "A day has 24 hours, so checking against hours higher than 24 is impossible": {
      "comment": "Error message",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Den má 24 hodin, takže kontrola hodin vyšších než 24 není možná"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tag hat 24 Stunden, daher ist eine Prüfung gegen Stunden über 24 nicht möglich"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A day has 24 hours, so checking against hours higher than 24 is impossible"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A day has 24 hours, so checking against hours higher than 24 is impossible"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un día tiene 24 horas, por lo que es imposible comprobar horas superiores a 24"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Päevas on 24 tundi, seega pole võimalik kontrollida tunde, mis on suuremad kui 24"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivässä on 24 tuntia, joten yli 24 tunnin tarkistaminen on mahdotonta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une journée a 24 heures, il est donc impossible de vérifier des heures supérieures à 24"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy nap 24 órából áll, ezért 24-nél magasabb óra ellenőrzése lehetetlen"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un giorno ha 24 ore, quindi non è possibile verificare ore superiori a 24"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Paroje yra 24 valandos, todėl tikrinti valandas, didesnes nei 24, neįmanoma"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dienā ir 24 stundas, tāpēc pārbaude pret stundām, kas lielākas par 24, nav iespējama"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En dag har 24 timer, så det er umulig å sjekke mot timer høyere enn 24"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een dag heeft 24 uur, dus controleren op uren hoger dan 24 is onmogelijk"
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein dag har 24 timar, så det er umogleg å sjekke mot timar høgare enn 24"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzień ma 24 godziny, więc sprawdzanie godzin wyższych niż 24 jest niemożliwe"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Deň má 24 hodín, preto nie je možné kontrolovať hodiny vyššie ako 24"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dan ima 24 ur, zato preverjanje ur višjih od 24 ni mogoče"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En dag har 24 timmar, så det är omöjligt att kontrollera mot timmar högre än 24"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "День має 24 години, тому перевірка годин більше 24 неможлива"
          }
        }
      }
    },
    "A day has no negative hours, so checking against hours lower than 0 is impossible": {
      "comment": "Error message",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Den nemá záporné hodiny, takže kontrola hodin nižších než 0 není možná"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tag hat keine negativen Stunden, daher ist eine Prüfung gegen Stunden unter 0 nicht möglich"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A day has no negative hours, so checking against hours lower than 0 is impossible"
