    "An attachment that will be displayed in the notification (optional, see UNNotificationAttachment for more information)": {
      "comment": "Parameter description",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příloha, která se zobrazí v oznámení (volitelné, viz UNNotificationAttachment pro více informací)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Anhang, der in der Mitteilung angezeigt wird (optional, siehe UNNotificationAttachment für weitere Informationen)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An attachment that will be displayed in the notification (optional, see UNNotificationAttachment for more information)"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "An attachment that will be displayed in the notification (optional, see UNNotificationAttachment for more information)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un adjunto que se mostrará en la notificación (opcional, consulta UNNotificationAttachment para más información)"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Manus, mida kuvatakse teavituses (valikuline, vaata UNNotificationAttachment lisateabe jaoks)"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liite, joka näytetään ilmoituksessa (valinnainen, katso lisätietoja UNNotificationAttachment-dokumentaatiosta)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une pièce jointe qui sera affichée dans la notification (facultatif, voir UNNotificationAttachment pour plus d'informations)"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az értesítésben megjelenő melléklet (opcionális, további információkért lásd az UNNotificationAttachment dokumentációt)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un allegato che verrà visualizzato nella notifica (opzionale, consulta UNNotificationAttachment per maggiori informazioni)"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Priedas, kuris bus rodomas pranešime (neprivaloma, daugiau informacijos žr. UNNotificationAttachment)"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pielikums, kas tiks parādīts paziņojumā (neobligāts, skatiet UNNotificationAttachment plašākai informācijai)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et vedlegg som vises i varselet (valgfritt, se UNNotificationAttachment for mer informasjon)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een bijlage die in de melding wordt weergegeven (optioneel, zie UNNotificationAttachment voor meer informatie)"
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Eit vedlegg som vert vist i varselet (valfritt, sjå UNNotificationAttachment for meir informasjon)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Załącznik, który będzie wyświetlany w powiadomieniu (opcjonalnie, zobacz UNNotificationAttachment po więcej informacji)"
