    "The (unencoded) input of the Shortcut to run when the notification is tapped (optional)": {
      "comment": "Parameter description",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Некодираният вход на прекия път, който да се изпълни при докосване на известието (незадължително)"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
