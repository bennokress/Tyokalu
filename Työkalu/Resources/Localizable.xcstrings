    "The (unencoded) input of the Shortcut to run when the notification is tapped (optional)": {
      "comment": "Parameter description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die (nicht kodierte) Eingabe des Kurzbefehls, der beim Tippen auf die Mitteilung ausgeführt wird (optional)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The (unencoded) input of the Shortcut to run when the notification is tapped (optional)"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The (unencoded) input of the Shortcut to run when the notification is tapped (optional)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La entrada (sin codificar) del atajo a ejecutar cuando se toca la notificación (opcional)"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikakomennon (koodaamaton) syöte, joka suoritetaan ilmoitusta napautettaessa (valinnainen)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'entrée (non encodée) du raccourci à exécuter lorsque la notification est touchée (facultatif)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'input (non codificato) del comando rapido da eseguire quando la notifica viene toccata (opzionale)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den (ukodede) inngangen til snarveien som skal kjøres når varselet trykkes (valgfritt)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De (niet-gecodeerde) invoer van de opdracht die wordt uitgevoerd wanneer op de melding wordt getikt (optioneel)"
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Den (ukoda) inngangen til snarvegen som skal køyrast når varselet vert trykt (valfritt)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "(Niekodowane) wejście skrótu do uruchomienia po dotknięciu powiadomienia (opcjonalnie)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den (okodade) inmatningen till genvägen som ska köras när aviseringen trycks (valfritt)"
          }
        }
      }
    },
    "The URL to open when the notification is tapped (required if 'Tap Action' is \"Open URL\")": {
      "comment": "Parameter description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die URL, die beim Tippen auf die Mitteilung geöffnet wird (erforderlich, wenn \"Tippaktion\" \"URL öffnen\" ist)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The URL to open when the notification is tapped (required if 'Tap Action' is \"Open URL\")"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The URL to open when the notification is tapped (required if 'Tap Action' is \"Open URL\")"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La URL a abrir cuando se toca la notificación (requerido si «Acción al tocar» es «Abrir URL»)"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "URL-osoite, joka avataan ilmoitusta napautettaessa (pakollinen jos \"Napauta-toiminto\" on \"Avaa URL\")"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'URL à ouvrir lorsque la notification est touchée (requis si « Action au toucher » est « Ouvrir l'URL »)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'URL da aprire quando la notifica viene toccata (obbligatorio se \"Azione al tocco\" è \"Apri URL\")"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "URL-en som skal åpnes når varselet trykkes (påkrevd hvis «Trykk-handling» er «Åpne URL»)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De URL die wordt geopend wanneer op de melding wordt getikt (vereist als 'Tikactie' \"Open URL\" is)"
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "URL-en som skal opnast når varselet vert trykt (påkravd viss «Trykkhandling» er «Opne URL»)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "URL do otwarcia po dotknięciu powiadomienia (wymagane, jeśli „Akcja dotknięcia\" to „Otwórz URL\")"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "URL:en som ska öppnas när aviseringen trycks (krävs om \"Tryck-åtgärd\" är \"Öppna URL\")"
          }
        }
      }
    },
