        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action renverra une valeur booléenne indiquant si la date donnée correspond au type de jour donné."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a művelet egy logikai értéket ad vissza, amely jelzi, hogy az adott dátum az adott naptípussal rendelkezik-e."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa azione restituirà un valore booleano che indica se la data fornita ha il tipo di giorno specificato."
