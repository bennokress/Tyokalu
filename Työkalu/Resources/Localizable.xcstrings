    "Tap the button below to open Settings, then enable \"Allow Notifications\" for this app.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Докоснете бутона по-долу, за да отворите Настройки, след което активирайте „Разрешаване на известия\" за това приложение."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na tlačítko níže pro otevření Nastavení a poté povolte „Povolit oznámení\" pro tuto aplikaci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf die Taste unten, um die Einstellungen zu öffnen, und aktiviere dann \"Mitteilungen erlauben\" für diese App."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε το κουμπί παρακάτω για να ανοίξετε τις Ρυθμίσεις και μετά ενεργοποιήστε την επιλογή «Να επιτρέπονται οι ειδοποιήσεις» για αυτήν την εφαρμογή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the button below to open Settings, then enable \"Allow Notifications\" for this app."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the button below to open Settings, then enable \"Allow Notifications\" for this app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el botón de abajo para abrir Ajustes, luego activa «Permitir notificaciones» para esta app."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vajuta allpool olevat nuppu Seadete avamiseks, seejärel luba „Luba teavitused\" selle rakenduse jaoks."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta alla olevaa painiketta avataksesi Asetukset ja ota sitten käyttöön \"Salli ilmoitukset\" tälle sovellukselle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur le bouton ci-dessous pour ouvrir Réglages, puis activez « Autoriser les notifications » pour cette app."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirnite gumb u nastavku za otvaranje Postavki, zatim omogućite \"Dopusti obavijesti\" za ovu aplikaciju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints az alábbi gombra a Beállítások megnyitásához, majd engedélyezd az „Értesítések engedélyezése\" opciót ennél az alkalmazásnál."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il pulsante qui sotto per aprire Impostazioni, quindi abilita \"Consenti notifiche\" per questa app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下のボタンをタップして設定を開き、このアプリの「通知を許可」を有効にしてください。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Paspauskite žemiau esantį mygtuką, kad atidarytumėte Nustatymus, tada įjunkite „Leisti pranešimus\" šiai programėlei."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pieskarieties pogai zemāk, lai atvērtu Iestatījumus, tad iespējojiet \"Atļaut paziņojumus\" šai lietotnei."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på knappen nedenfor for å åpne Innstillinger, og aktiver deretter «Tillat varsler» for denne appen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op de knop hieronder om Instellingen te openen en schakel vervolgens \"Meldingen toestaan\" in voor deze app."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på knappen nedanfor for å opne Innstillingar, og aktiver deretter «Tillat varslar» for denne appen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij poniższego przycisku, aby otworzyć Ustawienia, a następnie włącz „Zezwalaj na powiadomienia\" dla tej aplikacji."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atingeți butonul de mai jos pentru a deschide Setări, apoi activați „Permite notificări\" pentru această aplicație."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťuknite na tlačidlo nižšie pre otvorenie Nastavení a potom povoľte \"Povoliť oznámenia\" pre túto aplikáciu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapnite spodnji gumb za odprtje Nastavitev, nato omogočite »Dovoli obvestila« za to aplikacijo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på knappen nedan för att öppna Inställningar och aktivera sedan \"Tillåt aviseringar\" för denna app."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarları açmak için aşağıdaki düğmeye dokunun, ardından bu uygulama için \"Bildirimlere İzin Ver\" seçeneğini etkinleştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть кнопку нижче, щоб відкрити Параметри, а потім увімкніть «Дозволити сповіщення» для цього додатка."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击下方按钮打开\"设置\"，然后为此App启用\"允许通知\"。"
          }
        }
      }
    },
