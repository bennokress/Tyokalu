    "The (unencoded) input of the Shortcut to run when the notification is tapped (optional)": {
      "comment": "Parameter description",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "(Nekódovaný) vstup zkratky, která se spustí při klepnutí na oznámení (volitelné)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die (nicht kodierte) Eingabe des Kurzbefehls, der beim Tippen auf die Mitteilung ausgeführt wird (optional)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The (unencoded) input of the Shortcut to run when the notification is tapped (optional)"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The (unencoded) input of the Shortcut to run when the notification is tapped (optional)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La entrada (sin codificar) del atajo a ejecutar cuando se toca la notificación (opcional)"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Otsetee (kodeerimata) sisend, mida käivitada teavitusele vajutamisel (valikuline)"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikakomennon (koodaamaton) syöte, joka suoritetaan ilmoitusta napautettaessa (valinnainen)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'entrée (non encodée) du raccourci à exécuter lorsque la notification est touchée (facultatif)"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A parancs (nem kódolt) bemenete, amely az értesítés megérintésekor fut (opcionális)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'input (non codificato) del comando rapido da eseguire quando la notifica viene toccata (opzionale)"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "(Neužkoduota) sparčiosios komandos įvestis, kuri bus paleista palietus pranešimą (neprivaloma)"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Saīsnes (nekodētā) ievade, kas jāpalaiž, kad paziņojums tiek pieskarts (neobligāts)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den (ukodede) inngangen til snarveien som skal kjøres når varselet trykkes (valgfritt)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De (niet-gecodeerde) invoer van de opdracht die wordt uitgevoerd wanneer op de melding wordt getikt (optioneel)"
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Den (ukoda) inngangen til snarvegen som skal køyrast når varselet vert trykt (valfritt)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "(Niekodowane) wejście skrótu do uruchomienia po dotknięciu powiadomienia (opcjonalnie)"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "(Nekódovaný) vstup skratky, ktorá sa spustí po ťuknutí na oznámenie (voliteľné)"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "(Nekodiran) vhod bližnjice, ki se zažene ob dotiku obvestila (neobvezno)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den (okodade) inmatningen till genvägen som ska köras när aviseringen trycks (valfritt)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "(Незакодований) вхід швидкої команди для запуску при натисканні сповіщення (необов'язково)"
          }
        }
      }
    },
    "The URL to open when the notification is tapped (required if 'Tap Action' is \"Open URL\")": {
      "comment": "Parameter description",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "URL adresa, která se otevře při klepnutí na oznámení (vyžadováno, pokud je „Akce při klepnutí\" nastavena na „Otevřít URL\")"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die URL, die beim Tippen auf die Mitteilung geöffnet wird (erforderlich, wenn \"Tippaktion\" \"URL öffnen\" ist)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The URL to open when the notification is tapped (required if 'Tap Action' is \"Open URL\")"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The URL to open when the notification is tapped (required if 'Tap Action' is \"Open URL\")"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La URL a abrir cuando se toca la notificación (requerido si «Acción al tocar» es «Abrir URL»)"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "URL, mida avada teavitusele vajutamisel (kohustuslik, kui „Puutetoiming\" on „Ava URL\")"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "URL-osoite, joka avataan ilmoitusta napautettaessa (pakollinen jos \"Napauta-toiminto\" on \"Avaa URL\")"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'URL à ouvrir lorsque la notification est touchée (requis si « Action au toucher » est « Ouvrir l'URL »)"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A megnyitandó URL, amikor az értesítésre koppintasz (kötelező, ha a „Koppintási művelet\" „URL megnyitása\")"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'URL da aprire quando la notifica viene toccata (obbligatorio se \"Azione al tocco\" è \"Apri URL\")"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "URL, kurį atidaryti palietus pranešimą (privaloma, jei „Palietimo veiksmas\" yra „Atidaryti URL\")"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "URL, kas jāatver, kad paziņojums tiek pieskarts (obligāts, ja «Pieskāriena darbība» ir «Atvērt URL»)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "URL-en som skal åpnes når varselet trykkes (påkrevd hvis «Trykk-handling» er «Åpne URL»)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De URL die wordt geopend wanneer op de melding wordt getikt (vereist als 'Tikactie' \"Open URL\" is)"
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "URL-en som skal opnast når varselet vert trykt (påkravd viss «Trykkhandling» er «Opne URL»)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "URL do otwarcia po dotknięciu powiadomienia (wymagane, jeśli „Akcja dotknięcia\" to „Otwórz URL\")"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "URL adresa, ktorá sa otvorí po ťuknutí na oznámenie (vyžaduje sa, ak je \"Akcia pri ťuknutí\" nastavená na \"Otvoriť URL\")"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "URL, ki se odpre ob dotiku obvestila (zahtevano, če je »Dejanje ob dotiku« »Odpri URL«)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "URL:en som ska öppnas när aviseringen trycks (krävs om \"Tryck-åtgärd\" är \"Öppna URL\")"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "URL для відкриття при натисканні сповіщення (обов'язково, якщо «Дія при натисканні» - «Відкрити URL»)"
          }
        }
      }
    },
