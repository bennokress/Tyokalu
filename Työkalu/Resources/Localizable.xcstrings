    "Please grant notification permission to use all features.": {
      "comment": "Permission status: unknown default",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Моля, разрешете известията, за да използвате всички функции."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro použití všech funkcí prosím udělte oprávnění k oznámením."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte erteile die Mitteilungsberechtigung, um alle Funktionen zu nutzen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παρακαλώ παραχωρήστε άδεια ειδοποιήσεων για να χρησιμοποιήσετε όλες τις λειτουργίες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please grant notification permission to use all features."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Please grant notification permission to use all features."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, concede permiso de notificación para usar todas las funciones."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Palun anna teavituste luba, et kasutada kõiki funktsioone."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Myönnä ilmoituslupa käyttääksesi kaikkia ominaisuuksia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez accorder l'autorisation de notification pour utiliser toutes les fonctionnalités."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odobrite dozvolu za obavijesti kako biste koristili sve značajke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kérjük, add meg az értesítési engedélyt az összes funkció használatához."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Concedi l'autorizzazione alle notifiche per utilizzare tutte le funzionalità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての機能を使用するには通知の許可を与えてください。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prašome suteikti pranešimų leidimą, kad galėtumėte naudoti visas funkcijas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lūdzu, piešķiriet paziņojumu atļauju, lai izmantotu visas funkcijas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vennligst gi varslingstillatelse for å bruke alle funksjoner."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verleen meldingstoestemming om alle functies te gebruiken."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ver venleg og gje varslingsløyve for å bruke alle funksjonar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Proszę udzielić uprawnienia do powiadomień, aby używać wszystkich funkcji."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vă rugăm să acordați permisiunea pentru notificări pentru a utiliza toate funcțiile."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prosím udeľte povolenie pre oznámenia, aby ste mohli používať všetky funkcie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prosimo, podelite dovoljenje za obvestila za uporabo vseh funkcij."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vänligen ge aviseringsbehörighet för att använda alla funktioner."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm özellikleri kullanmak için lütfen bildirim izni verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Будь ласка, надайте дозвіл на сповіщення, щоб використовувати всі функції."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请授予通知权限以使用所有功能。"
          }
        }
      }
    },
