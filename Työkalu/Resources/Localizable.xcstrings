          "stringUnit": {
            "state": "translated",
            "value": "See rakendus on sinu tööriistakast Otseteede jaoks, pakkudes korduvkasutatavaid toiminguid, mida Apple vaikimisi ei sisalda."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä sovellus on työkalupakkisi Pikakomennoille, tarjoten uudelleenkäytettäviä toimintoja joita Apple ei sisällytä valmiiksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette app est votre boîte à outils pour Raccourcis, fournissant des actions réutilisables qu'Apple n'inclut pas par défaut."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az alkalmazás a Parancsok eszköztárad, amely újrafelhasználható műveleteket biztosít, amelyeket az Apple nem tartalmaz alapból."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa app è la tua cassetta degli attrezzi per Comandi Rapidi, fornendo azioni riutilizzabili che Apple non include di default."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ši programėlė yra jūsų įrankių rinkinys programėlei Sparčiosios komandos, teikiantis pakartotinai naudojamus veiksmus, kurių Apple neįtraukia į standartinę versiją."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šī lietotne ir jūsu rīku kaste lietotnei Saīsnes, nodrošinot atkārtoti izmantojamas darbības, kuras Apple neiekļauj pēc noklusējuma."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne appen er din verktøykasse for Snarveier, og gir gjenbrukbare handlinger som Apple ikke inkluderer som standard."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze app is jouw gereedschapskist voor Opdrachten en biedt herbruikbare handelingen die Apple niet standaard meelevert."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne appen er verktøykassa di for Snarvegar, og gjev attbrukande handlingar som Apple ikkje inkluderer som standard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta aplikacja to Twój zestaw narzędzi dla Skrótów, oferujący czynności wielokrotnego użytku, które Apple nie dołącza standardowo."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Táto aplikácia je váš panel nástrojov pre Skratky, ktorý poskytuje opakovane použiteľné akcie, ktoré Apple štandardne neponúka."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta aplikacija je vaša orodjarna za Bližnjice, ki zagotavlja dejanja za večkratno uporabo, ki jih Apple ne vključuje v osnovno različico."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Denna app är din verktygslåda för Genvägar och tillhandahåller återanvändbara åtgärder som Apple inte inkluderar som standard."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей додаток - ваш набір інструментів для Швидких команд, що надає багаторазові дії, які Apple не включає за замовчуванням."
          }
        }
      }
    },
