        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze handeling retourneert een Booleaanse waarde die aangeeft of de gegeven datum het gegeven type dag heeft."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne handlinga vil returnere ein boolsk verdi som representerer om den gjevne datoen har den gjevne typen dag."
