    "Notification permission was denied. Please enable it in Settings to use notification actions.": {
      "comment": "Permission status: denied",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oprávnění k oznámením bylo zamítnuto. Pro použití akcí oznámení jej prosím povolte v Nastavení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Mitteilungsberechtigung wurde abgelehnt. Bitte aktiviere sie in den Einstellungen, um Mitteilungsaktionen zu nutzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification permission was denied. Please enable it in Settings to use notification actions."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification permission was denied. Please enable it in Settings to use notification actions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se denegó el permiso de notificación. Por favor, actívalo en Ajustes para usar acciones de notificación."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teavituste luba keelati. Palun luba see Seadetes, et kasutada teavituste toiminguid."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoituslupa evättiin. Ota se käyttöön Asetuksissa käyttääksesi ilmoitustoimintoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autorisation de notification a été refusée. Veuillez l'activer dans Réglages pour utiliser les actions de notification."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az értesítési engedélyt megtagadták. Kérjük, engedélyezd a Beállításokban az értesítési műveletek használatához."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autorizzazione alle notifiche è stata negata. Abilitala nelle Impostazioni per utilizzare le azioni di notifica."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pranešimų leidimas buvo atmestas. Prašome įjungti jį Nustatymuose, kad galėtumėte naudoti pranešimų veiksmus."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Paziņojumu atļauja tika noraidīta. Lūdzu, iespējojiet to Iestatījumos, lai izmantotu paziņojumu darbības."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varslingstillatelse ble avslått. Vennligst aktiver det i Innstillinger for å bruke varslingshandlinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingstoestemming is geweigerd. Schakel deze in via Instellingen om meldingshandelingen te gebruiken."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Varslingsløyve vart avslått. Ver venleg og aktiver det i Innstillingar for å bruke varslingshandlingar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uprawnienie do powiadomień zostało odrzucone. Włącz je w Ustawieniach, aby używać akcji powiadomień."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolenie pre oznámenia bolo zamietnuté. Prosím povoľte ho v Nastaveniach, aby ste mohli používať akcie oznámení."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dovoljenje za obvestila je bilo zavrnjeno. Prosimo, omogočite ga v Nastavitvah za uporabo dejanj obvestil."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviseringsbehörighet nekades. Vänligen aktivera den i Inställningar för att använda aviseringsåtgärder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвіл на сповіщення було відхилено. Будь ласка, увімкніть його в Параметрах, щоб використовувати дії сповіщень."
          }
        }
      }
    },
    "Notification permission was denied. To use notification actions in Shortcuts, you need to enable notifications in the Settings app.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oprávnění k oznámením bylo zamítnuto. Pro použití akcí oznámení ve Zkratkách musíte povolit oznámení v aplikaci Nastavení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Mitteilungsberechtigung wurde abgelehnt. Um Mitteilungsaktionen in Kurzbefehlen zu verwenden, musst du Mitteilungen in der Einstellungen-App aktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification permission was denied. To use notification actions in Shortcuts, you need to enable notifications in the Settings app."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification permission was denied. To use notification actions in Shortcuts, you need to enable notifications in the Settings app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se denegó el permiso de notificación. Para usar acciones de notificación en Atajos, necesitas activar las notificaciones en la app de Ajustes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teavituste luba keelati. Et kasutada teavituste toiminguid Otseteedes, pead lubama teavitused Seadete rakenduses."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoituslupa evättiin. Käyttääksesi ilmoitustoimintoja Pikakomennoissa sinun täytyy ottaa ilmoitukset käyttöön Asetukset-sovelluksessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autorisation de notification a été refusée. Pour utiliser les actions de notification dans Raccourcis, vous devez activer les notifications dans l'app Réglages."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az értesítési engedélyt megtagadták. Az értesítési műveletek használatához a Parancsokban engedélyezned kell az értesítéseket a Beállítások alkalmazásban."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autorizzazione alle notifiche è stata negata. Per utilizzare le azioni di notifica in Comandi Rapidi, devi abilitare le notifiche nell'app Impostazioni."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pranešimų leidimas buvo atmestas. Norėdami naudoti pranešimų veiksmus programėlėje Sparčiosios komandos, turite įjungti pranešimus Nustatymų programėlėje."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Paziņojumu atļauja tika noraidīta. Lai izmantotu paziņojumu darbības lietotnē Saīsnes, jums jāiespējo paziņojumi lietotnē Iestatījumi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varslingstillatelse ble avslått. For å bruke varslingshandlinger i Snarveier må du aktivere varsler i Innstillinger-appen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingstoestemming is geweigerd. Om meldingshandelingen in Opdrachten te gebruiken, moet je meldingen inschakelen in de Instellingen-app."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Varslingsløyve vart avslått. For å bruke varslingshandlingar i Snarvegar må du aktivere varslar i Innstillingar-appen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uprawnienie do powiadomień zostało odrzucone. Aby używać akcji powiadomień w Skrótach, musisz włączyć powiadomienia w aplikacji Ustawienia."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolenie pre oznámenia bolo zamietnuté. Ak chcete používať akcie oznámení v Skratkách, musíte povoliť oznámenia v aplikácii Nastavenia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dovoljenje za obvestila je bilo zavrnjeno. Za uporabo dejanj obvestil v Bližnjicah morate omogočiti obvestila v aplikaciji Nastavitve."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviseringsbehörighet nekades. För att använda aviseringsåtgärder i Genvägar måste du aktivera aviseringar i appen Inställningar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвіл на сповіщення було відхилено. Щоб використовувати дії сповіщень у Швидких командах, потрібно увімкнути сповіщення в програмі Параметри."
          }
        }
      }
    },
