    "Notifications are provisionally allowed. Grant full permission for the best experience.": {
      "comment": "Permission status: provisional",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Известията са временно разрешени. Дайте пълно разрешение за най-добро изживяване."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznámení jsou prozatímně povolena. Pro nejlepší zážitek udělte plné oprávnění."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind vorläufig erlaubt. Erteile die vollständige Berechtigung für das beste Erlebnis."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ειδοποιήσεις επιτρέπονται προσωρινά. Παραχωρήστε πλήρη άδεια για την καλύτερη εμπειρία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are provisionally allowed. Grant full permission for the best experience."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are provisionally allowed. Grant full permission for the best experience."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están permitidas provisionalmente. Concede permiso completo para la mejor experiencia."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teavitused on ajutiselt lubatud. Anna täielik luba parima kogemuse jaoks."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoitukset ovat väliaikaisesti sallittuja. Myönnä täysi lupa parhaaseen kokemukseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont autorisées provisoirement. Accordez l'autorisation complète pour une meilleure expérience."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obavijesti su privremeno dopuštene. Odobrite punu dozvolu za najbolje iskustvo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az értesítések ideiglenesen engedélyezettek. A legjobb élmény érdekében adj meg teljes engedélyt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche sono temporaneamente consentite. Concedi l'autorizzazione completa per la migliore esperienza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知は仮許可されています。最高のエクスペリエンスを得るには完全な許可を与えてください。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pranešimai laikinai leidžiami. Suteikite visą leidimą geriausiai patirčiai."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Paziņojumi ir pagaidām atļauti. Piešķiriet pilnu atļauju labākai pieredzei."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsler er foreløpig tillatt. Gi full tillatelse for best opplevelse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen zijn voorlopig toegestaan. Verleen volledige toestemming voor de beste ervaring."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Varslar er førebels tillatne. Gje fullt løyve for best oppleving."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia są tymczasowo dozwolone. Udziel pełnego uprawnienia dla najlepszego doświadczenia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificările sunt permise provizoriu. Acordați permisiunea completă pentru cea mai bună experiență."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznámenia sú dočasne povolené. Udeľte úplné povolenie pre najlepší zážitok."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obvestila so začasno dovoljena. Podelite polno dovoljenje za najboljšo izkušnjo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviseringar är preliminärt tillåtna. Ge fullständig behörighet för bästa upplevelse."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirimler geçici olarak izin verildi. En iyi deneyim için tam izin verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщення дозволені тимчасово. Надайте повний дозвіл для найкращого досвіду."
          }
        },
        "zh-Hans": {
