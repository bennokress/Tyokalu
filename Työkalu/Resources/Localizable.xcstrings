    "Setting a Notification ID will replace any older notification with the same Notification ID": {
      "comment": "Parameter description",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavení ID oznámení nahradí všechna starší oznámení se stejným ID oznámení"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Setzen einer Mitteilungs-ID ersetzt alle älteren Mitteilungen mit derselben Mitteilungs-ID"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Setting a Notification ID will replace any older notification with the same Notification ID"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Setting a Notification ID will replace any older notification with the same Notification ID"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Establecer un ID de notificación reemplazará cualquier notificación anterior con el mismo ID de notificación"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teavituse ID määramine asendab kõik vanemad sama teavituse ID-ga teavitused"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoituksen tunnisteen asettaminen korvaa kaikki vanhemmat ilmoitukset samalla tunnisteella"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définir un ID de notification remplacera toute notification plus ancienne avec le même ID de notification"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Értesítés-azonosító beállítása lecseréli az összes korábbi értesítést ugyanazzal az értesítés-azonosítóval"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'impostazione di un ID notifica sostituirà qualsiasi notifica precedente con lo stesso ID notifica"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nustačius pranešimo ID, bus pakeisti visi senesni pranešimai su tuo pačiu pranešimo ID"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Paziņojuma ID iestatīšana aizstās visus vecākos paziņojumus ar tādu pašu paziņojuma ID"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å sette en varslings-ID vil erstatte eldre varsler med samme varslings-ID"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het instellen van een Meldings-ID vervangt elke oudere melding met dezelfde Meldings-ID"
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Å setje ein varslings-ID vil erstatte eldre varslar med same varslings-ID"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawienie ID powiadomienia zastąpi wszystkie starsze powiadomienia z tym samym ID powiadomienia"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavenie ID oznámenia nahradí všetky staršie oznámenia s rovnakým ID oznámenia"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavitev ID-ja obvestila bo nadomestila vsako starejše obvestilo z enakim ID-jem obvestila"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att ange ett aviserings-ID ersätter alla äldre aviseringar med samma aviserings-ID"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Встановлення ID сповіщення замінить будь-яке старіше сповіщення з тим самим ID сповіщення"
          }
        }
      }
    },
    "Setting a Thread ID will group the notification with other notifications that have the same Thread ID": {
      "comment": "Parameter description",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavení ID vlákna seskupí oznámení s ostatními oznámeními, která mají stejné ID vlákna"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Setzen einer Thread-ID gruppiert die Mitteilung mit anderen Mitteilungen, die dieselbe Thread-ID haben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Setting a Thread ID will group the notification with other notifications that have the same Thread ID"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Setting a Thread ID will group the notification with other notifications that have the same Thread ID"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Establecer un ID de hilo agrupará la notificación con otras notificaciones que tengan el mismo ID de hilo"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lõime ID määramine grupeerib teavituse teiste sama lõime ID-ga teavitustega"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Säikeen tunnisteen asettaminen ryhmittelee ilmoituksen muiden samalla säikeen tunnisteella olevien ilmoitusten kanssa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définir un ID de fil regroupera la notification avec d'autres notifications ayant le même ID de fil"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szálazonosító beállítása csoportosítja az értesítést más, azonos szálazonosítójú értesítésekkel"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'impostazione di un ID thread raggrupperà la notifica con altre notifiche che hanno lo stesso ID thread"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nustačius gijos ID, pranešimas bus sugrupuotas su kitais pranešimais, turinčiais tą patį gijos ID"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pavediena ID iestatīšana grupēs paziņojumu ar citiem paziņojumiem, kuriem ir tāds pats pavediena ID"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å sette en tråd-ID vil gruppere varselet med andre varsler som har samme tråd-ID"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het instellen van een Thread-ID groepeert de melding met andere meldingen die dezelfde Thread-ID hebben"
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Å setje ein tråd-ID vil gruppere varselet med andre varslar som har same tråd-ID"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawienie ID wątku zgrupuje powiadomienie z innymi powiadomieniami, które mają to samo ID wątku"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavenie ID vlákna zoskupí oznámenie s ostatnými oznámeniami, ktoré majú rovnaké ID vlákna"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavitev ID-ja niti bo združila obvestilo z drugimi obvestili, ki imajo enak ID niti"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att ange ett tråd-ID grupperar aviseringen med andra aviseringar som har samma tråd-ID"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Встановлення ID потоку згрупує сповіщення з іншими сповіщеннями, які мають той самий ID потоку"
          }
        }
      }
