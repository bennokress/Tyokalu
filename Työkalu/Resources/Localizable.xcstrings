    "This action will return a Boolean value representing if the given date has the given type of day.": {
      "comment": "Intent description",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato akce vrátí booleovskou hodnotu reprezentující, zda má dané datum daný typ dne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aktion gibt einen booleschen Wert zurück, der angibt, ob das gegebene Datum den gegebenen Tagestyp hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action will return a Boolean value representing if the given date has the given type of day."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This action will return a Boolean value representing if the given date has the given type of day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta acción devolverá un valor booleano que representa si la fecha dada tiene el tipo de día dado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See toiming tagastab tõeväärtuse, mis näitab, kas antud kuupäev on antud päevatüüp."
