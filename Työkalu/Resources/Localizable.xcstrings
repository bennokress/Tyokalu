            "value": "Diese Aktion gibt einen booleschen Wert zurück, der angibt, ob die Stunde des gegebenen Datums innerhalb des gegebenen Zeitraums liegt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η ενέργεια θα επιστρέψει μια τιμή Boolean που υποδεικνύει αν η ώρα της δεδομένης ημερομηνίας είναι εντός του δεδομένου χρονικού πλαισίου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action will return a Boolean value representing if the hour of the given date is inside the given time frame."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This action will return a Boolean value representing if the hour of the given date is inside the given time frame."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta acción devolverá un valor booleano que representa si la hora de la fecha dada está dentro del intervalo de tiempo dado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See toiming tagastab tõeväärtuse, mis näitab, kas antud kuupäeva tund on antud ajavahemikus."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä toiminto palauttaa totuusarvon, joka kertoo onko annetun päivämäärän tunti annetun ajanjakson sisällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action renverra une valeur booléenne indiquant si l'heure de la date donnée se situe dans la plage horaire donnée."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova radnja će vratiti Booleovu vrijednost koja predstavlja je li sat danog datuma unutar danog vremenskog okvira."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a művelet egy logikai értéket ad vissza, amely jelzi, hogy az adott dátum órája a megadott időkereten belül van-e."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa azione restituirà un valore booleano che indica se l'ora della data fornita è compresa nell'intervallo di tempo specificato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアクションは、指定された日付の時刻が指定された時間枠内にあるかどうかを表すブール値を返します。"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis veiksmas grąžins loginę reikšmę, nurodančią, ar nurodytos datos valanda yra nurodytame laiko intervale."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šī darbība atgriezīs Būla vērtību, kas norāda, vai dotā datuma stunda ir dotajā laika periodā."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne handlingen vil returnere en boolsk verdi som representerer om timen til den gitte datoen er innenfor den gitte tidsrammen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze handeling retourneert een Booleaanse waarde die aangeeft of het uur van de gegeven datum binnen het gegeven tijdsbestek valt."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne handlinga vil returnere ein boolsk verdi som representerer om timen til den gjevne datoen er innanfor den gjevne tidsramma."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta czynność zwróci wartość logiczną reprezentującą, czy godzina podanej daty mieści się w podanym przedziale czasowym."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această acțiune va returna o valoare booleană care reprezintă dacă ora datei date se află în intervalul de timp dat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Táto akcia vráti boolovskú hodnotu reprezentujúcu, či hodina daného dátumu je v danom časovom rámci."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "To dejanje bo vrnilo logično vrednost, ki predstavlja, ali je ura danega datuma znotraj danega časovnega okvira."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Denna åtgärd returnerar ett booleskt värde som representerar om timmen för det angivna datumet ligger inom den angivna tidsramen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem, verilen tarihin saatinin verilen zaman dilimi içinde olup olmadığını temsil eden bir Boolean değeri döndürür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця дія поверне логічне значення, яке вказує, чи година заданої дати знаходиться в межах заданого часового проміжку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
