          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Työkalu\" yra suomiškas žodis, reiškiantis \"įrankis\"."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Työkalu\" ir somu valodas vārds \"rīks\"."
