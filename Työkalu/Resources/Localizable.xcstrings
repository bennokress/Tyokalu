    "Notification permission was denied. Please enable it in Settings to use notification actions.": {
      "comment": "Permission status: denied",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Mitteilungsberechtigung wurde abgelehnt. Bitte aktiviere sie in den Einstellungen, um Mitteilungsaktionen zu nutzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification permission was denied. Please enable it in Settings to use notification actions."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification permission was denied. Please enable it in Settings to use notification actions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se denegó el permiso de notificación. Por favor, actívalo en Ajustes para usar acciones de notificación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoituslupa evättiin. Ota se käyttöön Asetuksissa käyttääksesi ilmoitustoimintoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autorisation de notification a été refusée. Veuillez l'activer dans Réglages pour utiliser les actions de notification."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autorizzazione alle notifiche è stata negata. Abilitala nelle Impostazioni per utilizzare le azioni di notifica."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varslingstillatelse ble avslått. Vennligst aktiver det i Innstillinger for å bruke varslingshandlinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingstoestemming is geweigerd. Schakel deze in via Instellingen om meldingshandelingen te gebruiken."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Varslingsløyve vart avslått. Ver venleg og aktiver det i Innstillingar for å bruke varslingshandlingar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uprawnienie do powiadomień zostało odrzucone. Włącz je w Ustawieniach, aby używać akcji powiadomień."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviseringsbehörighet nekades. Vänligen aktivera den i Inställningar för att använda aviseringsåtgärder."
          }
        }
      }
    },
    "Notification permission was denied. To use notification actions in Shortcuts, you need to enable notifications in the Settings app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Mitteilungsberechtigung wurde abgelehnt. Um Mitteilungsaktionen in Kurzbefehlen zu verwenden, musst du Mitteilungen in der Einstellungen-App aktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification permission was denied. To use notification actions in Shortcuts, you need to enable notifications in the Settings app."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification permission was denied. To use notification actions in Shortcuts, you need to enable notifications in the Settings app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se denegó el permiso de notificación. Para usar acciones de notificación en Atajos, necesitas activar las notificaciones en la app de Ajustes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoituslupa evättiin. Käyttääksesi ilmoitustoimintoja Pikakomennoissa sinun täytyy ottaa ilmoitukset käyttöön Asetukset-sovelluksessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autorisation de notification a été refusée. Pour utiliser les actions de notification dans Raccourcis, vous devez activer les notifications dans l'app Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autorizzazione alle notifiche è stata negata. Per utilizzare le azioni di notifica in Comandi Rapidi, devi abilitare le notifiche nell'app Impostazioni."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varslingstillatelse ble avslått. For å bruke varslingshandlinger i Snarveier må du aktivere varsler i Innstillinger-appen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingstoestemming is geweigerd. Om meldingshandelingen in Opdrachten te gebruiken, moet je meldingen inschakelen in de Instellingen-app."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Varslingsløyve vart avslått. For å bruke varslingshandlingar i Snarvegar må du aktivere varslar i Innstillingar-appen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uprawnienie do powiadomień zostało odrzucone. Aby używać akcji powiadomień w Skrótach, musisz włączyć powiadomienia w aplikacji Ustawienia."
