    "Once notification permission is granted, there's no additional functionality here other than using the test button below to verify notifications work correctly.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jakmile je uděleno oprávnění k oznámením, není zde žádná další funkcionalita kromě použití testovacího tlačítka níže pro ověření, že oznámení fungují správně."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald die Mitteilungsberechtigung erteilt wurde, gibt es hier keine weitere Funktionalität außer der Verwendung der Testtaste unten, um zu überprüfen, ob Mitteilungen korrekt funktionieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once notification permission is granted, there's no additional functionality here other than using the test button below to verify notifications work correctly."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Once notification permission is granted, there's no additional functionality here other than using the test button below to verify notifications work correctly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez concedido el permiso de notificación, no hay funcionalidad adicional aquí más que usar el botón de prueba de abajo para verificar que las notificaciones funcionan correctamente."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui teavituste luba on antud, pole siin muud funktsionaalsust peale alloleva testnupu kasutamise, et kontrollida teavituste korrektset toimimist."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun ilmoituslupa on myönnetty, tässä ei ole muuta toiminnallisuutta kuin alla olevan testipainikkeen käyttäminen ilmoitusten toiminnan varmistamiseksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois l'autorisation de notification accordée, il n'y a pas d'autres fonctionnalités ici, à part utiliser le bouton de test ci-dessous pour vérifier que les notifications fonctionnent correctement."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az értesítési engedély megadása után itt nincs más funkció, csak az alábbi tesztgomb használata az értesítések helyes működésének ellenőrzésére."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una volta concessa l'autorizzazione alle notifiche, non ci sono altre funzionalità qui oltre all'utilizzo del pulsante di test qui sotto per verificare che le notifiche funzionino correttamente."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kai suteikiamas pranešimų leidimas, čia nėra jokių papildomų funkcijų, išskyrus žemiau esančio bandomojo mygtuko naudojimą patikrinti, ar pranešimai veikia tinkamai."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad paziņojumu atļauja ir piešķirta, šeit nav citas funkcionalitātes, izņemot testa pogas izmantošanu zemāk, lai pārbaudītu, vai paziņojumi darbojas pareizi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når varslingstillatelse er gitt, er det ingen annen funksjonalitet her enn å bruke testknappen nedenfor for å bekrefte at varsler fungerer riktig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zodra meldingstoestemming is verleend, is er hier geen extra functionaliteit behalve het gebruik van de testknop hieronder om te verifiëren dat meldingen correct werken."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Når varslingsløyve er gjeve, finst det ingen annan funksjonalitet her enn å bruke testknappen nedanfor for å stadfeste at varslar fungerer rett."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po udzieleniu uprawnienia do powiadomień, nie ma tu żadnej dodatkowej funkcjonalności poza użyciem przycisku testowego poniżej, aby zweryfikować, że powiadomienia działają poprawnie."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Po udelení povolenia pre oznámenia tu nie je žiadna ďalšia funkcionalita okrem použitia testovacieho tlačidla nižšie na overenie správneho fungovania oznámení."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko je dovoljenje za obvestila podeljeno, tu ni nobene dodatne funkcionalnosti razen uporabe testnega gumba spodaj za preverjanje, da obvestila delujejo pravilno."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När aviseringsbehörighet har beviljats finns det ingen ytterligare funktionalitet här förutom att använda testknappen nedan för att verifiera att aviseringar fungerar korrekt."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після надання дозволу на сповіщення тут немає додаткових функцій, окрім використання кнопки тестування нижче для перевірки правильності роботи сповіщень."
          }
        }
      }
    },
