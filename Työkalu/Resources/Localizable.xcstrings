    "This action will return a Boolean value representing if the given date has the given type of day.": {
      "comment": "Intent description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aktion gibt einen booleschen Wert zurück, der angibt, ob das gegebene Datum den gegebenen Tagestyp hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action will return a Boolean value representing if the given date has the given type of day."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This action will return a Boolean value representing if the given date has the given type of day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta acción devolverá un valor booleano que representa si la fecha dada tiene el tipo de día dado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä toiminto palauttaa totuusarvon, joka kertoo onko annetulla päivämäärällä annettu päivätyyppi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action renverra une valeur booléenne indiquant si la date donnée correspond au type de jour donné."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa azione restituirà un valore booleano che indica se la data fornita ha il tipo di giorno specificato."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne handlingen vil returnere en boolsk verdi som representerer om den gitte datoen har den gitte typen dag."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze handeling retourneert een Booleaanse waarde die aangeeft of de gegeven datum het gegeven type dag heeft."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne handlinga vil returnere ein boolsk verdi som representerer om den gjevne datoen har den gjevne typen dag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta czynność zwróci wartość logiczną reprezentującą, czy podana data ma podany typ dnia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Denna åtgärd returnerar ett booleskt värde som representerar om det angivna datumet har den angivna typen av dag."
          }
        }
      }
    },
    "This action will return a Boolean value representing if the hour of the given date is inside the given time frame.": {
      "comment": "Intent description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aktion gibt einen booleschen Wert zurück, der angibt, ob die Stunde des gegebenen Datums innerhalb des gegebenen Zeitraums liegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action will return a Boolean value representing if the hour of the given date is inside the given time frame."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This action will return a Boolean value representing if the hour of the given date is inside the given time frame."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta acción devolverá un valor booleano que representa si la hora de la fecha dada está dentro del intervalo de tiempo dado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä toiminto palauttaa totuusarvon, joka kertoo onko annetun päivämäärän tunti annetun ajanjakson sisällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action renverra une valeur booléenne indiquant si l'heure de la date donnée se situe dans la plage horaire donnée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa azione restituirà un valore booleano che indica se l'ora della data fornita è compresa nell'intervallo di tempo specificato."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne handlingen vil returnere en boolsk verdi som representerer om timen til den gitte datoen er innenfor den gitte tidsrammen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze handeling retourneert een Booleaanse waarde die aangeeft of het uur van de gegeven datum binnen het gegeven tijdsbestek valt."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne handlinga vil returnere ein boolsk verdi som representerer om timen til den gjevne datoen er innanfor den gjevne tidsramma."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta czynność zwróci wartość logiczną reprezentującą, czy godzina podanej daty mieści się w podanym przedziale czasowym."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Denna åtgärd returnerar ett booleskt värde som representerar om timmen för det angivna datumet ligger inom den angivna tidsramen."
          }
        }
      }
    },
    "This app is your toolbox for Shortcuts, providing reusable actions that Apple doesn't include out of the box.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App ist dein Werkzeugkasten für Kurzbefehle und bietet wiederverwendbare Aktionen, die Apple nicht standardmäßig mitliefert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
