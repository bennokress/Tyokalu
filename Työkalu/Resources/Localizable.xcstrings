        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre une boîte de dialogue système pour autoriser les notifications de cette app"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvara sistemski dijaloški okvir za dopuštanje obavijesti od ove aplikacije"
