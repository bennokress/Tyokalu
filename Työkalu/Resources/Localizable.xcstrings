          }
        }
      }
    },
    "This app is your toolbox for Shortcuts, providing reusable actions that Apple doesn't include out of the box.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това приложение е вашата кутия с инструменти за Shortcuts, предоставяйки действия за многократна употреба, които Apple не включва стандартно."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato aplikace je vaše sada nástrojů pro Zkratky, poskytující opakovaně použitelné akce, které Apple standardně nezahrnuje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App ist dein Werkzeugkasten für Kurzbefehle und bietet wiederverwendbare Aktionen, die Apple nicht standardmäßig mitliefert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η εφαρμογή είναι η εργαλειοθήκη σας για τις Συντομεύσεις, παρέχοντας επαναχρησιμοποιήσιμες ενέργειες που η Apple δεν περιλαμβάνει εκ των προτέρων."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app is your toolbox for Shortcuts, providing reusable actions that Apple doesn't include out of the box."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This app is your toolbox for Shortcuts, providing reusable actions that Apple doesn't include out of the box."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta app es tu caja de herramientas para Atajos, proporcionando acciones reutilizables que Apple no incluye de serie."
